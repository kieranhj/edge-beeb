# ---- Build output ----
# build.ps1 puts everything it produces in build/: the disc image, the 200K
# padded copy for jsbeeb, and beebasm's assembly listing
build/
*.ssd
*.SSD
*.dsd
compile.txt

# beebasm's SAVE writes a loose host file whenever it has no disc image to
# put it in, so any run without a working -do drops these in the project root
/Edge
/BANK0
/BANK1
/BANK2
/BANK3
/MUSIC
/LOADSC1
/LOADSC2
/!BOOT

# ---- Third-party tools (beebasm lives in ..\..\Bin; a local copy is optional) ----
bin/

# ---- Python ----
__pycache__/
*.pyc

# ---- Local editor / agent settings ----
.claude/settings.local.json
.vscode/

# ---- Original game binaries (copyright Cosine; keep locally) ----
*.d64

# ---- Generated previews (tools/render_bbc.py) ----
tools/output/

# ---- Guide layers (tools/art_grid.py, tools/paint_map.py --grid) ----
# Transparent overlays over the sheets, regenerated in one command. Never art,
# never read back; assets/art/map/ is ignored whole, just below.
assets/art/*-grid.png

# ---- The level as a painting (tools/paint_map.py export) ----
# Derived from assets/art/chars-bbc.png and the tile/map tables, and read back
# into it by `paint_map.py import`. The canvas is the artist's working file,
# not a source: regenerate it rather than committing a 9664 x 160 PNG.
assets/art/map/

# ---- Arkos player harness intermediates (tools/akl/verify_akl.py) ----
# The song exported at the SIMULATOR's address, the sim image, its labels, the
# YM oracle and any captured .snf. All regenerated by verify_akl.py.
tools/akl/build/
